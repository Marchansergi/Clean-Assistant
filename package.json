{
  "name": "clean-assistant",
  "productName": "Clean Assistant",
  "version": "0.3.0",
  "description": "Mini agentes de escritorio (Claude y ChatGPT) que usan tu ordenador con un cursor propio.",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "cross-spawn": "^7.0.6",
    "electron": "^38.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.11",
    "openai": "^7.45.1",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.cleanassistant.app",
    "productName": "Clean Assistant",
    "copyright": "Clean Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "dist/mcp-bridge/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clean Assistant",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerSidebar": "assets/installer-sidebar.bmp",
      "uninstallerSidebar": "assets/installer-sidebar.bmp",
      "runAfterFinish": true,
      "language": "3082",
      "installerLanguages": [
        "es_ES"
      ],
      "artifactName": "Clean-Assistant-Setup-${version}.exe",
      "uninstallDisplayName": "Clean Assistant"
    },
    "compression": "maximum",
    "electronLanguages": [
      "es",
      "es-419",
      "en-US"
    ]
  },
  "author": "Clean Assistant"
}
